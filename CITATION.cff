cff-version: 1.2.0
message: "This is a satirical note, not a preprint. If you must cite it, cite it as satire."
title: "[Satire] Reciting is not decompressing: a neural LZMA2 decoder that learned the answer key and not the algorithm"
type: software
authors:
  - family-names: Li
    given-names: Jinpeng
    orcid: "https://orcid.org/0009-0002-8236-1768"
    affiliation: "Independent researcher"
